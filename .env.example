# Nexamind.Ai LLM configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER=openai
LLM_MODEL=

# Web search: duckduckgo needs no key; google requires both values below.
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_TIMEOUT_S=12
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional: limit the HotpotQA corpus loaded for the local RAG demo.
DEMO_CORPUS_QUESTIONS=20
